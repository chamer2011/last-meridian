{
  "name": "last-meridian",
  "productName": "The Last Meridian",
  "version": "0.1.0",
  "description": "A sci-fi text RPG with an AI game master",
  "author": "The Last Meridian",
  "private": true,
  "type": "module",
  "main": "app/main.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/",
    "app": "electron .",
    "build-app": "node app/build.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.lastmeridian.game",
    "productName": "The Last Meridian",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**",
      "public/**",
      "src/**",
      "world/**",
      "server.js",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "app/icon.ico"
    },
    "nsis": {
      "artifactName": "The-Last-Meridian-Setup.exe",
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "The Last Meridian",
      "deleteAppDataOnUninstall": false
    }
  }
}
